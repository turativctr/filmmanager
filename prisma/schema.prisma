model CalendarEvent {
  id                 String            @id @default(cuid())
  projectId          String
  data               DateTime
  tipo               CalendarEventType
  nome               String
  elementosAfetados  String[]
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("calendar_events")
}

// Prazo de pré-produção ("Entrega da decupagem") — diferente de CalendarEvent porque não ocupa
// tempo num dia, é cumprido ou atrasado. Atrasada continua aparecendo até ser concluída (evento
// passado simplesmente sai da vista). responsavel é texto livre (departamento ou nome) — sem
// vínculo com User/CrewMember, sem permissão, sem notificação: o AD controla e cobra por fora.
model Task {
  id          String    @id @default(cuid())
  projectId   String
  titulo      String
  descricao   String?   @db.Text
  prazo       DateTime
  responsavel String?
  concluida   Boolean   @default(false)
  concluidaEm DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("tasks")
}

// ---------------------------------------------------------------------------
// Módulo Budgeting
// ---------------------------------------------------------------------------

model Budget {
  id                     String   @id @default(cuid())
  projectId              String   @unique
  moedaBase              String   @default("BRL")
  versao                 String   @default("1.0")
  contingenciaPercentual Decimal  @default(10) @db.Decimal(5, 2)
  notas                  String?  @db.Text
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  project         Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  accountGroups   AccountGroup[]
  accounts        BudgetAccount[]
  lineItems       LineItem[]
  globals         Global[]
  fringes         Fringe[]
  fringeLineItems FringeLineItem[]
  scenarios       BudgetScenario[]
  actuals         Actual[]

  @@map("budgets")
}

model AccountGroup {
  id       String           @id @default(cuid())
  budgetId String
  codigo   String
  nome     String
  tipo     AccountGroupType
  ordem    Int

  budget   Budget          @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  accounts BudgetAccount[]

  @@unique([budgetId, codigo])
  @@map("account_groups")
}

model BudgetAccount {
  id       String @id @default(cuid())
  groupId  String
  budgetId String
  codigo   String
  nome     String
  ordem    Int

  group           AccountGroup     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  budget          Budget           @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  lineItems       LineItem[]
  fringeLineItems FringeLineItem[]
  actuals         Actual[]

  @@unique([budgetId, codigo])
  @@map("budget_accounts")
}

model LineItem {
  id           String   @id @default(cuid())
  accountId    String
  budgetId     String
  scenarioId   String?
  descricao    String
  quantidade   Decimal  @db.Decimal(10, 2)
  unidade      String
  periodo      Decimal  @default(1) @db.Decimal(10, 2)
  taxa         Decimal  @db.Decimal(12, 2)
  moeda        String   @default("BRL")
  taxaCambio   Decimal  @default(1.0) @db.Decimal(10, 4)
  total        Decimal  @db.Decimal(14, 2)
  isFrengeable Boolean  @default(false)
  globalRef    String?
  notas        String?  @db.Text
  ordem        Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  account  BudgetAccount   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  budget   Budget          @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  scenario BudgetScenario? @relation(fields: [scenarioId], references: [id], onDelete: SetNull)

  @@map("line_items")
}

model Global {
  id          String   @id @default(cuid())
  budgetId    String
  chave       String
  valor       Decimal  @db.Decimal(10, 2)
  descricao   String?
  afetaLinhas String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  budget Budget @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  @@unique([budgetId, chave])
  @@map("globals")
}

model Fringe {
  id         String     @id @default(cuid())
  budgetId   String
  nome       String
  percentual Decimal    @db.Decimal(5, 2)
  teto       Decimal?   @db.Decimal(12, 2)
  aplicaEm   String[]
  tipo       FringeType
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  budget          Budget           @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  fringeLineItems FringeLineItem[]

  @@map("fringes")
}

model FringeLineItem {
  id        String  @id @default(cuid())
  fringeId  String
  budgetId  String
  accountId String?
  base      Decimal @db.Decimal(14, 2)
  valor     Decimal @db.Decimal(14, 2)

  fringe  Fringe         @relation(fields: [fringeId], references: [id], onDelete: Cascade)
  budget  Budget         @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  account BudgetAccount? @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("fringe_line_items")
}

model BudgetScenario {
  id       String  @id @default(cuid())
  budgetId String
  nome     String
  isBase   Boolean @default(false)
  notas    String? @db.Text

  budget    Budget                   @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  lineItems LineItem[]
  overrides ScenarioGlobalOverride[]

  @@map("budget_scenarios")
}

model ScenarioGlobalOverride {
  id         String  @id @default(cuid())
  scenarioId String
  chave      String
  valor      Decimal @db.Decimal(10, 2)

  scenario BudgetScenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)

  @@unique([scenarioId, chave])
  @@map("scenario_global_overrides")
}

model Actual {
  id        String   @id @default(cuid())
  budgetId  String
  accountId String
  descricao String
  valor     Decimal  @db.Decimal(14, 2)
  data      DateTime
  notas     String?  @db.Text
  createdAt DateTime @default(now())

  budget  Budget        @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  account BudgetAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("actuals")
}

// ---------------------------------------------------------------------------
// Documentos do AD
// ---------------------------------------------------------------------------

model ContinuityNote {
  id         String   @id @default(cuid())
  sceneId    String
  shootDayId String? // dia em que a nota foi registrada, se aplicável
  texto      String   @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  scene    Scene     @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  shootDay ShootDay? @relation(fields: [shootDayId], references: [id], onDelete: SetNull)

  @@map("continuity_notes")
}

model CrewMember {
  id           String   @id @default(cuid())
  projectId    String
  nome         String
  funcao       String
  departamento String?
  telefone     String?
  email        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("crew_members")
}

model DailyProgressReport {
  id                 String   @id @default(cuid())
  shootDayId         String   @unique
  cenasConcluidas    String[] // números das cenas efetivamente concluídas nesta diária
  cenasNaoConcluidas String[] // números das cenas previstas mas não concluídas (ficam pra outro dia)
  paginasFilmadas    Decimal  @default(0) @db.Decimal(6, 3)
  horaInicioReal     String?
  horaTerminoReal    String?
  atrasoMin          Int? // positivo = atrasado, negativo = adiantado
  motivoAtraso       String?  @db.Text
  observacoes        String?  @db.Text
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  shootDay ShootDay @relation(fields: [shootDayId], references: [id], onDelete: Cascade)

  @@map("daily_progress_reports")
}
