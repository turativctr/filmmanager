generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Auth (NextAuth.js — credentials/email+senha)
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  passwordHash  String
  emailVerified DateTime?
  image         String?
  role          Role      @default(USER)
  tourConcluido Boolean   @default(false)
  // Tema é por PESSOA, não por projeto — é sobre olho/ambiente de quem usa o app, não sobre o
  // filme. Também fica guardado num cookie (ver src/lib/theme.ts) pra a primeira renderização já
  // vir certa, sem piscar. O Modo de Set ignora isso de propósito (ver set-mode/layout.tsx).
  tema          Tema      @default(DOCUMENTARIO)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]
  projects Project[]

  @@map("users")
}

enum Role {
  USER
  ADMIN
}

// Onda 3: CLARO renomeado pra DOCUMENTARIO (nome de gênero, como todos os outros — "claro" era o
// único sem nome de gênero). Onda 4: EXPERIMENTAL renomeado pra FUTURISTA (o conceito visual virou
// neon noir, "experimental" não descrevia mais nada). O enum continua NÃO fechado.
enum Tema {
  DOCUMENTARIO
  NOIR
  COMEDIA
  HISTORICO
  HORROR
  DRAMA
  TELENOVELA
  FUTURISTA
  FANTASIA
  THRILLER
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ---------------------------------------------------------------------------
// Enums — módulo Scheduling
// ---------------------------------------------------------------------------

enum SceneEnvironment {
  INT
  EXT
}

// Fechado — o que stripboard (cor da tira), DOOD/escaleta e ordem de diária consultam. Derivado
// de Scene.periodo (texto livre, nunca um enum — roteiro brasileiro usa MADRUGADA, ENTARDECER,
// CREPÚSCULO, "X PARA Y" e qualquer combinação que o roteirista escrever; um enum fechado quebra
// no próximo roteiro), nunca digitado à mão. Ver deriveClasseLuz em src/lib/fdx-parser.ts.
enum ClasseLuz {
  DIA
  NOITE
  // Cena que atravessa de um período para o outro dentro dela mesma (ex.: "NOITE PARA
  // MADRUGADA") — filmada em dois momentos de luz distintos. Scene.periodoFim guarda a ponta
  // final.
  TRANSICAO
  // Período não determinado (roteiro diz "CONTÍNUO"/"MOMENTOS DEPOIS", ou o texto não foi
  // reconhecido) — herda a classe da cena anterior na importação; se não há cena anterior pra
  // herdar, fica INDEFINIDO mesmo e é sinalizado pra revisão do AD.
  INDEFINIDO
}

enum CharacterCategoria {
  PRINCIPAL
  COADJUVANTE
  PARTICIPACAO_ESPECIAL
  FIGURACAO
  VOZ_OFF
  DUPLO
  OUTRO
}

enum SceneBlock {
  MANHA
  TARDE
}

enum SceneShootDayStatus {
  PENDENTE
  EM_ANDAMENTO
  CONCLUIDA
  ADIADA
}

enum CalendarEventType {
  ENSAIO
  VIAGEM
  FIGURINO
  FERIADO
  FOLGA
  OUTRO
}

// Como os personagens são identificados nos documentos gerados — ver lib/character-id.ts.
enum SistemaIdElenco {
  ID_CURTO // padrão Movie Magic/americano: "PRO", "CHEF"
  NUMERACAO // padrão brasileiro/europeu: "1", "2", na ordem cadastrada em /cast
}

enum ProjectStatus {
  ATIVO
  CONCLUIDO
}

enum ProjectStepEtapa {
  ROTEIRO
  ELENCO
  BREAKDOWN
  CRONOGRAMA
  ORDEM_DO_DIA
  ORCAMENTO
}

// Tipo de reset entre um plano e o anterior — calculado automaticamente por classifyReset()
// (src/lib/shots.ts) a partir de lente/movimento/tamanho/ângulo, mas editável manualmente.
enum ShotTipoReset {
  NENHUM
  AJUSTE
  TROCA_LENTE
  TROCA_CAMERA
  RESET_POSICAO
  RESET_COMPLETO
}

enum ShotStatus {
  PENDENTE
  FILMADO
  DESCARTADO
}

// O que pode cair quando a diária estoura — decisão da AD, nunca inferida. Padrão DESEJAVEL, não
// ESSENCIAL: se tudo nascesse essencial a classificação viraria ruído; assim a AD precisa marcar o
// que de fato não pode cair. Cada plano tem a sua (coverage não herda do pai).
enum ShotPrioridade {
  ESSENCIAL // sem ele a cena não monta
  DESEJAVEL // melhora, mas a cena fecha sem ele
  SE_DER_TEMPO // primeiro a cair
}

enum HoraAHoraEventTipo {
  CHAMADA_EQUIPE
  CHAMADA_ELENCO
  SETUP
  ENSAIO
  RODANDO
  ALMOCO
  SAIDA
  DESPRODUCAO
  OUTRO
}

// ---------------------------------------------------------------------------
// Enums — módulo Budgeting
// ---------------------------------------------------------------------------

enum AccountGroupType {
  ATL
  BTL_PRODUCAO
  BTL_POS
  OUTROS
}

enum FringeType {
  INSS
  FGTS
  ISS
  OUTRO
}

// ---------------------------------------------------------------------------
// Módulo Scheduling
// ---------------------------------------------------------------------------

model Project {
  id        String   @id @default(cuid())
  titulo    String
  diretor   String?
  producao  String?
  dataInicio DateTime?
  dataFim    DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Sigla usada no nome dos arquivos gerados (relatórios/exports). Se não definida, calculada
  // automaticamente a partir do título por getSigla() — ver lib/filename.ts.
  sigla String?

  ownerId String?
  owner   User?   @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  equipeTecnica Int? // headcount fixo de equipe técnica, usado na contagem de refeições do DOOD

  // Metadados extraídos do TitlePage do roteiro (.fdx/.wdz) no onboarding — texto livre, nunca parseado como data/número.
  roteiristas     String?
  numeroDraft     String?
  dataDraft       String?
  contatoProducao String? @db.Text

  logoUrl         String? // logo da produtora, exibido no header da Call Sheet
  sistemaIdElenco SistemaIdElenco @default(ID_CURTO)

  // Configuração do Boletim de Continuísmo (por projeto)
  continuismoResponsavel     String  @default("Continuidade")
  continuismoUsarLogo        Boolean @default(true)
  continuismoLinhasPorFolha  Int     @default(12)

  // status = fase da produção; arquivado = visibilidade/organização — eixos independentes,
  // arquivar um projeto concluído não pode "apagar" que ele foi concluído.
  status    ProjectStatus @default(ATIVO)
  arquivado Boolean       @default(false)

  // Marca produção real (dado que importa de verdade, não teste/demo) — scripts de manutenção em
  // massa (ex.: scripts/recount-locacoes.ts) exigem confirmação extra antes de tocar num projeto
  // com protegido=true. Marcado À MÃO pelo admin; NUNCA por título — um nome bate por sorte hoje
  // e para de bater no dia em que alguém renomeia o projeto, corrige um acento, ou o título muda
  // de outro jeito qualquer, e a proteção cai em silêncio.
  protegido Boolean @default(false)

  // Configuração da "Jornada" do dia de filmagem — usada por recalculateDayBlocks (src/lib/shootday-blocks.ts)
  // pra derivar blocoManhaInicio/almocoInicio/almocoFim/blocoTardeInicio de cada ShootDay. O almoço nunca é
  // definido diretamente pelo AD: ele é consequência de onde o marcador fica no Stripboard (ver ShootDay).
  // Faixas de ponto de partida por tipo de cena (estágio 3 da estimativa), ajustáveis uma vez por
  // produção — o padrão é chute de gente de set, e editar aqui faz o chute passar a ser da equipe.
  // Formato e validação em src/lib/estimativa.ts; null = usa o padrão.
  faixasTempo          Json?

  limiteAlmocoMin      Int @default(360) // praxe de mercado: 5 a 6h após a chamada geral
  duracaoAlmocoMin     Int @default(60)
  preparacaoInicialMin Int @default(60) // chamada geral -> início da 1ª cena

  // Padrão de tempos de reset entre planos, por tipo classificado por classifyReset() (ver
  // src/lib/shots-shared.ts) — calibrável por projeto, porque equipe entrosada e locação apertada
  // mudam quanto tempo cada troca realmente leva. NENHUM não tem campo (é sempre zero). Defaults
  // idênticos aos valores que antes eram fixos em RESET_MINUTES, pra nada mudar visualmente até
  // alguém calibrar de propósito.
  resetAjusteMin      Int @default(3)
  resetTrocaLenteMin  Int @default(8)
  resetTrocaCameraMin Int @default(10)
  resetPosicaoMin     Int @default(15)
  resetCompletoMin    Int @default(20)

  // Setado por scripts/recount-eighths.ts quando ele não encontra o arquivo original do roteiro
  // pra recalcular os oitavos de cenas importadas antes da correção do algoritmo de contagem —
  // nunca adivinha um valor novo, só avisa o AD que a contagem pode estar errada e precisa
  // reimportar. Nunca setado por código de produto, só pelo script.
  oitavosDesatualizados Boolean @default(false)

  scenes         Scene[]
  characters     Character[]
  shootDays      ShootDay[]
  extras         Extra[]
  calendarEvents CalendarEvent[]
  budget         Budget?
  scriptDrafts   ScriptDraft[]
  crewMembers    CrewMember[]
  stepOverrides  ProjectStepOverride[]
  shots          Shot[]
  shotSchedules  ShotSchedule[]
  locacoes       Locacao[]
  tasks          Task[]

  @@map("projects")
}

// Permite marcar manualmente uma etapa do painel de progresso guiado como concluída, mesmo que o
// critério automático (calculado do banco) ainda não tenha sido atingido. Se o critério automático
// depois passar a "completo" por conta própria, a exibição usa o status automático — o override fica
// dormente, sem precisar ser apagado.
model ProjectStepOverride {
  id                   String           @id @default(cuid())
  projectId            String
  etapa                ProjectStepEtapa
  concluidaManualmente Boolean          @default(false)
  concluidaEm          DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, etapa])
  @@map("project_step_overrides")
}

enum ClassificacaoTempoCena {
  NAO_CLASSIFICADO
  DIALOGO_ESTATICO
  COM_MOVIMENTO
  EFEITO_VFX
  EXTERIOR
}

model Scene {
  id                String           @id @default(cuid())
  projectId         String
  numero            String
  tipo              SceneEnvironment?
  // Texto livre normalizado em maiúscula, exatamente como veio do cabeçalho do roteiro (ex.:
  // "MADRUGADA", "NOITE PARA MADRUGADA") — nunca comparado contra uma lista fechada. Ver
  // classeLuz abaixo pro que alimenta cor de tira/DOOD/ordem de diária.
  periodo           String?
  // Só preenchido quando periodo é uma transição "X PARA Y" — a ponta final (Y). Usado na
  // herança de classeLuz da cena seguinte quando ela é CONTÍNUO/indefinida (ver
  // applyClasseLuzInheritance em src/lib/fdx-parser.ts).
  periodoFim        String?
  // Derivado de periodo (nunca digitado à mão) — ver comentário no enum ClasseLuz.
  classeLuz         ClasseLuz        @default(INDEFINIDO)
  // Set = lugar da ficção, vem do roteiro ("RUA", "APARTAMENTO DE ANA CLARA") — texto livre.
  // Locação = lugar real onde se filma, decisão de produção — entidade própria (ver Locacao). O
  // roteiro não conhece a locação: "EXT. RUA" pode virar três ruas diferentes na produção.
  set               String?
  locacaoId         String?
  sinopse           String?          @db.Text
  // Frase operacional curta do AD pra Escaleta do AD e Hora a Hora — diferente da sinopse longa do
  // roteiro. Se vazia, a UI/PDF caem pra sinopse truncada em 80 chars (ver resolveSinopseAD).
  sinopseAD         String?          @db.Text
  paginas           Decimal          @default(0) @db.Decimal(6, 3)
  // Linhas brutas contadas na importação (ver lib/fdx-parser.ts e lib/pdf-script-parser.ts) — o
  // dado de origem por trás de `paginas`. Guardado à parte pra permitir recalcular oitavos sem
  // reimportar o roteiro, se a regra de contagem mudar de novo (ver scripts/recount-eighths.ts).
  // Null pra cenas criadas antes desse campo existir, ou quando paginasEditadoManualmente = true
  // (a contagem bruta deixa de corresponder ao valor editado à mão).
  linhas            Int?
  diaNarrativo      Int?
  tempoEstimadoMin  Int?
  // Tempo que a AD decide dar pra cena ("tempo reverso"), digitado à mão. Diferente de
  // tempoEstimadoMin (estimativa automática por oitavos): quando preenchido, é ELE que vira o Rod da
  // cena em toda diária (SceneShootDay.rodMin) e a soma dos planos passa a ser só a base do aviso de
  // estouro. null = comportamento de sempre, Rod vem da soma dos planos. Nunca redistribui os tempos
  // dos planos — a média por plano é só exibida (ver src/lib/tempo-alvo.ts).
  duracaoAlvoMin    Int?
  // Classificação ESCOLHIDA pela AD (nunca inferida do texto) — só serve pro estágio 3 da
  // estimativa, a faixa de ponto de partida por plano quando o projeto ainda não tem realizado
  // lançado. NAO_CLASSIFICADO é o padrão e é um estado legítimo: sem ela o app diz "sem base pra
  // estimar" em vez de inventar número.
  classificacaoTempo ClassificacaoTempoCena @default(NAO_CLASSIFICADO)
  // Vira true assim que o AD edita `paginas` ou `tempoEstimadoMin` diretamente (formulário de
  // cena ou de breakdown) — a reimportação de um novo draft (import/fdx/confirm, drafts) passa a
  // preservar os três campos (paginas/tempoEstimadoMin/linhas) em vez de recalcular por cima,
  // igual ao padrão já usado em SceneShootDay.observacoesAutoGeradas.
  paginasEditadoManualmente Boolean  @default(false)
  // Convenção WGA: uma cena removida numa revisão nunca é deletada nem tem seu número reciclado —
  // fica marcada OMITIDA no lugar, preservando a numeração/continuidade entre drafts.
  omitida           Boolean          @default(false)
  notasAD           String?          @db.Text // anotação livre do AD, visível na Escaleta e no Stripboard
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  project         Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  locacao         Locacao?         @relation(fields: [locacaoId], references: [id], onDelete: SetNull)
  cast            SceneCast[]
  shootDays       SceneShootDay[]
  extras          ExtraScene[]
  breakdownSheet  BreakdownSheet?
  continuityNotes ContinuityNote[]
  shots           Shot[]
  parts           ScenePart[]

  @@unique([projectId, numero])
  @@map("scenes")
}

// Divisão da MESMA cena entre diárias (ex.: a imagem numa diária, o voice off em outra). Cena sem
// divisão não tem linha aqui — a parte é implícita e tudo funciona como sempre. Só existe quando a
// AD divide de fato, e aí são 2+ partes.
//
// Regra dura: a soma de `oitavos` das partes é igual aos oitavos da cena (paginas × 8) — oitavo
// nunca conta duas vezes, senão o total do projeto infla e o progresso mente. A API barra divisão
// que não fecha. Editar `Scene.paginas` depois continua liberado: aí a divisão pode deixar de
// fechar e a cena mostra o aviso "divisão não fecha" (avisa, não trava).
//
// A diária de cada parte mora em SceneShootDay.scenePartId (não aqui), pra não duplicar ordem,
// bloco, prep, Rod, status e horários reais.
model ScenePart {
  id        String   @id @default(cuid())
  sceneId   String
  // Texto livre: "Imagem", "Voice off", "Continuação", "Plano do dublê".
  rotulo    String
  // Fatia dos oitavos da cena. 0 é válido (captação de som pura, sem página).
  oitavos   Int
  // Ordem de exibição das partes dentro da cena (1, 2, ...).
  ordem     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  scene         Scene          @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  sceneShootDay SceneShootDay?
  shots         Shot[]

  @@index([sceneId])
  @@map("scene_parts")
}

// Lugar real onde se filma — decisão de produção, distinta do Set (lugar da ficção, vem do
// roteiro). Uma Locacao pode abrigar vários Sets ("Casa da Vó" = "SALA" + "COZINHA"), e um Set
// do roteiro pode corresponder a Locacoes diferentes ao longo da produção.
model Locacao {
  id              String   @id @default(cuid())
  projectId       String
  nome            String
  endereco        String?  @db.Text
  contatoNome     String?
  contatoTelefone String?
  notas           String?  @db.Text // estacionamento, restrições de horário, autorização

  // Hospital tem campos próprios, não vira ponto de apoio: é crítico de segurança e tem lugar
  // fixo no cabeçalho da Ordem do Dia.
  hospitalNome     String?
  hospitalEndereco String?  @db.Text
  hospitalTelefone String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scenes      Scene[]
  pontosApoio PontoApoio[]

  @@map("locacoes")
}

enum TipoPontoApoio {
  METRO_TREM
  ONIBUS
  ESTACIONAMENTO
  MERCADO
  FARMACIA
  RESTAURANTE
  POSTO_COMBUSTIVEL
  OUTRO
}

// descricao é texto livre de propósito — transporte público raramente cabe em campo estruturado
// (ex.: "Estação Jaraguá — Linha 7 Rubi da CPTM, cerca de 6 min a pé").
model PontoApoio {
  id        String         @id @default(cuid())
  locacaoId String
  tipo      TipoPontoApoio
  descricao String         @db.Text
  endereco  String?        @db.Text
  ordem     Int

  locacao Locacao @relation(fields: [locacaoId], references: [id], onDelete: Cascade)

  @@map("pontos_apoio")
}

// Decupagem da cena — um plano por linha, ordenado por `ordem` (editável via drag-and-drop).
// tempoResetMin/tipoReset são calculados por classifyReset() (comparando com o plano anterior na
// mesma `ordem`) + o padrão de tempos do Project — SEMPRE recalculados no servidor, nunca aceitos
// como input direto (mesma convenção de tempoTotalMin). tempoResetMinManual é o ajuste calibrado
// plano a plano (nulo = segue o padrão do projeto) — só ele é editável.
model Shot {
  id                String        @id @default(cuid())
  sceneId           String
  projectId         String
  ordem             Int
  numero            String
  descricao         String        @db.Text
  tamanho           String?
  lente             String?
  angulo            String?
  movimento         String?
  // takesPrevistos/duracaoTakeMin/tempoSetupMin são editáveis; tempoTotalMin é sempre recalculado
  // no servidor a partir dos três (takesPrevistos × duracaoTakeMin + tempoSetupMin) — nunca aceito
  // como input direto da API, mesma convenção de tipoReset/tempoResetMin.
  takesPrevistos      Int           @default(3)
  duracaoTakeMin      Int           @default(2)
  tempoSetupMin       Int           @default(0)
  tempoTotalMin       Int           @default(6)
  tempoResetMin       Int?
  tempoResetMinManual Int?
  tipoReset           ShotTipoReset @default(NENHUM)
  notasDirecao      String?       @db.Text
  notasContinuidade String?       @db.Text
  status            ShotStatus    @default(PENDENTE)
  // Plano principal da cena — no máximo um por cena (marcar outro desmarca o anterior, ver a rota
  // PATCH do plano). Marcar sobe o plano pro topo UMA vez; depois a AD reordena à vontade, não é
  // trava. Independente de coverage: dá pra ter master sem coverage e coverage de plano não-master.
  ehMaster          Boolean       @default(false)
  prioridade        ShotPrioridade @default(DESEJAVEL)
  // Coverage: plano pendurado em outro plano da MESMA cena, numerado com a letra do pai (6A, 6B).
  // Um nível só — coverage não tem coverage (barrado na API). A lista plana continua sendo o
  // padrão: null = plano solto. SetNull só como rede de segurança; a rota de DELETE desvincula os
  // coverages antes, pra renumerá-los com o próximo número livre.
  planoPaiId        String?
  // Parte da cena dividida em que o plano é filmado. null = sem parte: aparece em todas as partes,
  // mas não entra no Rod de nenhuma (senão contaria duas vezes). Nunca obrigatório.
  scenePartId       String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  scene     Scene   @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  planoPai  Shot?   @relation("ShotCoverage", fields: [planoPaiId], references: [id], onDelete: SetNull)
  coverages Shot[]  @relation("ShotCoverage")
  schedule ShotSchedule?
  scenePart ScenePart? @relation(fields: [scenePartId], references: [id], onDelete: SetNull)

  @@unique([sceneId, ordem])
  @@index([planoPaiId])
  @@index([scenePartId])
  @@map("shots")
}

// Controle total da OD por plano individual — reorganiza planos de filmagem livremente dentro do
// dia, independente da ordem/vínculo das cenas de origem (Shot.sceneId nunca muda). Um Shot sem
// ShotSchedule ainda não foi agendado num dia específico. `ordem` é a posição global no dia (cruza
// cenas); `tempoResetMin`/`tipoReset` aqui são o reset entre planos NO DIA — diferente dos mesmos
// campos em Shot, que refletem a ordem dentro da própria cena. `tempoResetMinManual` é o mesmo
// conceito de ajuste calibrado do Shot, só que pra este contexto (nulo = segue o padrão do projeto).
model ShotSchedule {
  id                  String         @id @default(cuid())
  shotId              String         @unique
  shootDayId          String
  projectId           String
  ordem               Int
  bloco               SceneBlock?
  tempoResetMin       Int?
  tempoResetMinManual Int?
  tipoReset           ShotTipoReset  @default(NENHUM)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  shot     Shot     @relation(fields: [shotId], references: [id], onDelete: Cascade)
  shootDay ShootDay @relation(fields: [shootDayId], references: [id], onDelete: Cascade)
  project  Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([shootDayId, ordem])
  @@map("shot_schedules")
}

model ScriptDraft {
  id          String   @id @default(cuid())
  projectId   String
  numero      Int // sequência do draft dentro do projeto (1 = original/Branco, 2 = primeira revisão...)
  corRevisao  String // rótulo de cor no padrão WGA — ver lib/revision-colors.ts
  numeroDraft String? // rótulo livre extraído do TitlePage do arquivo importado (ex.: "3rd Draft"), pode divergir de `numero`
  dataDraft   String?
  arquivoNome String?
  importedAt  DateTime @default(now())

  project    Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sceneDiffs SceneDiff[]

  @@unique([projectId, numero])
  @@map("script_drafts")
}

enum SceneDiffTipo {
  ADICIONADA
  REMOVIDA
  MODIFICADA
}

model SceneDiff {
  id              String        @id @default(cuid())
  scriptDraftId   String
  sceneNumero     String
  tipo            SceneDiffTipo
  // { campo: { antes, depois } } — só os campos que de fato mudaram nessa revisão
  camposAlterados Json?
  createdAt       DateTime      @default(now())

  scriptDraft ScriptDraft @relation(fields: [scriptDraftId], references: [id], onDelete: Cascade)

  @@unique([scriptDraftId, sceneNumero])
  @@map("scene_diffs")
}

model Character {
  id                String        @id @default(cuid())
  projectId         String
  idCurto           String
  numeroElenco      Int? // posição sequencial em /cast — usado quando Project.sistemaIdElenco = NUMERACAO
  categoria         CharacterCategoria @default(PRINCIPAL)
  personagem        String
  ator              String?
  idadePersonagem   Int?
  // true = teve fala detectada em algum ponto do roteiro (cue de diálogo); false = detectado só
  // por apresentação no texto de ação ("NOME, 35, descrição...") — nunca tem fala nenhuma cena.
  // Default true: preserva o comportamento anterior a este campo (toda importação antes disso só
  // criava personagem via cue de diálogo) e o de criação manual pela UI, onde não há como inferir
  // isso automaticamente. Alimenta contrato diferente, ordem na Call Sheet, e distinção de teste
  // de elenco vs. figuração especial na revisão do AD.
  temFala           Boolean @default(true)
  // Prestação de contas do elenco (AD)
  cacheeDiario       Decimal? @db.Decimal(10, 2)
  percentualHold     Decimal? @db.Decimal(5, 2) // % do cachê diário pago em dias de "hold" (aguardando, sem filmar)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  project   Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scenes    SceneCast[]
  callTimes CharacterCallTime[]

  @@unique([projectId, idCurto])
  @@map("characters")
}

model SceneCast {
  id          String @id @default(cuid())
  sceneId     String
  characterId String

  scene     Scene     @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([sceneId, characterId])
  @@map("scene_cast")
}

enum ModoPlanejamentoDiaria {
  DETALHADO
  SIMPLIFICADO
}

model ShootDay {
  id               String   @id @default(cuid())
  projectId        String
  numeroDia        Int
  data             DateTime
  chamadaGeral     String?
  lancheHorario    String?
  blocoManhaInicio String?
  almocoInicio     String?
  almocoFim        String?
  blocoTardeInicio String?
  desprodInicio    String?

  // Logística — Call Sheet
  transporteHorario  String?
  transporteEndereco String?  @db.Text
  locacaoNome        String?
  locacaoEndereco    String?  @db.Text
  baseInfo           String?  @db.Text // Base / Alimentação / Camarim
  estacionamento     String?  @db.Text
  hospitalNome       String?
  hospitalEndereco   String?  @db.Text
  hospitalTelefone   String?
  meteoNascer        String?
  meteoPor           String?
  meteoMin           Int?
  meteoMax           Int?
  meteoChuva         String?
  meteoDescricao     String?  @db.Text
  chamadaEquipe      Json? // Record<departamento, horario>
  observacoesGerais  String?  @db.Text
  observacaoCronogramaElenco String? @db.Text // nota de rodapé por diária no Cronograma de Elenco
  observacaoPlanoSimples     String? @db.Text // texto livre no Plano Simplificado para as Diárias

  // Ritmo dos resets DESTE dia — decisão de direção ("hoje vamos apertar"), não re-estimativa.
  // Multiplica o tempo de reset (base = ajuste manual do plano ou padrão do projeto) só em tempo de
  // leitura, nos lugares com esta diária em escopo (Stripboard, wizard da OD, PDFs) — nunca é
  // gravado em Shot/ShotSchedule nem entra no cálculo de Rod/blocoManha/almoço.
  fatorResetPercent Int @default(100)

  // Margem que a AD guarda pra atraso, do DIA (não da cena: colchão por cena somado em silêncio faz
  // perder a noção do total). NUNCA sai em PDF nem em tela compartilhada — se vazar num documento, a
  // equipe gasta a margem e a produção corta. Coberto por verify:pdf.
  reservaMin Int?

  // Teto da diária — orçamento de tempo do modo simplificado. Um OU outro, nunca os dois (a rota da
  // diária limpa o outro ao gravar um): jornadaMin = duração máxima contada da chamada geral (720 =
  // 12h); horaFimAlvo = "18:00", e aí a jornada é que sai da chamada. O teto só AVISA: nunca
  // redistribui prep/Rod nem bloqueia nada (ver src/lib/jornada-diaria.ts).
  jornadaMin  Int?
  horaFimAlvo String?
  // Como a AD planeja ESTA diária — só muda a tela, nunca o dado: prep/Rod são os mesmos campos de
  // SceneShootDay nos dois modos, e a OD/PDFs saem iguais. Por diária porque a mesma produção tem
  // diária decupada e diária corrida.
  modoPlanejamento ModoPlanejamentoDiaria @default(DETALHADO)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project   Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scenes    SceneShootDay[]
  blocos    ShootDayBlock[]
  callTimes CharacterCallTime[]
  checklist ShootDayChecklist[]
  continuityNotes     ContinuityNote[]
  dailyProgressReport DailyProgressReport?
  horaAHoraEvents     HoraAHoraEvent[]
  shotSchedules       ShotSchedule[]

  @@unique([projectId, numeroDia])
  @@map("shoot_days")
}

// Item de agenda da diária que não é cena nem plano: transporte, mudança de locação, espera de luz.
// Entra na timeline na posição que a AD escolher e soma no horário do dia, mas NÃO conta oitavo,
// cena, plano, DOOD nem progresso de páginas. Convive com o almoço (que não é registro: é marcador
// derivado do bloco das cenas, com regra própria de jornada).
//
// `ordem` é a posição na lista do dia junto com as cenas — SceneShootDay.ordem e ShootDayBlock.ordem
// compartilham a mesma sequência (a rota de reordenação grava as duas). `bloco` diz de que lado do
// almoço o item está, pela mesma regra das cenas.
model ShootDayBlock {
  id         String     @id @default(cuid())
  shootDayId String
  // Texto livre, até 30 caracteres: "Transporte", "Mudança de locação".
  rotulo     String
  duracaoMin Int
  ordem      Int
  bloco      SceneBlock @default(MANHA)
  // Realizado do bloco, lançado depois da diária na mesma tela das cenas (ver a rota realizado).
  // Bloco não tem status: em branco = não lançado.
  horaInicioReal String?
  horaFimReal    String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  shootDay ShootDay @relation(fields: [shootDayId], references: [id], onDelete: Cascade)

  @@index([shootDayId])
  @@map("shoot_day_blocks")
}

enum ShootDayChecklistTipo {
  LOCACAO
  TRANSPORTE
  ELENCO
  ARTE
  SOM
  FIGURINO
  MAKE
  PLAYBACK
  OUTRO
}

model ShootDayChecklist {
  id                    String                @id @default(cuid())
  shootDayId            String
  item                  String                @db.Text
  confirmado            Boolean               @default(false)
  tipo                  ShootDayChecklistTipo
  geradoAutomaticamente Boolean               @default(false)
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  shootDay ShootDay @relation(fields: [shootDayId], references: [id], onDelete: Cascade)

  @@map("shoot_day_checklists")
}

// Roteiro operacional do dia (Hora a Hora) — mistura eventos gerados automaticamente a partir do
// Stripboard/Ordem do Dia (chamadas, setups, rodagens, saídas) com eventos manuais do AD. Mesmo
// padrão do ShootDayChecklist: `geradoAutomaticamente` marca o que "Regenerar" pode substituir
// sem apagar o que foi adicionado à mão.
model HoraAHoraEvent {
  id                    String             @id @default(cuid())
  shootDayId            String
  horaInicio            String
  horaFim               String?
  descricao             String
  tipo                  HoraAHoraEventTipo
  geradoAutomaticamente Boolean            @default(false)
  ordem                 Int
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  shootDay ShootDay @relation(fields: [shootDayId], references: [id], onDelete: Cascade)

  @@map("hora_a_hora_events")
}

model CharacterCallTime {
  id          String   @id @default(cuid())
  characterId String
  shootDayId  String
  chamada     String?
  camarim     String?
  set         String?
  saida       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  shootDay  ShootDay  @relation(fields: [shootDayId], references: [id], onDelete: Cascade)

  @@unique([characterId, shootDayId])
  @@map("character_call_times")
}

model SceneShootDay {
  id             String              @id @default(cuid())
  sceneId        String
  shootDayId     String
  ordem          Int
  bloco          SceneBlock          @default(MANHA)
  prepMin        Int?
  rodMin         Int?
  // A AD DIGITOU este Rod (na tira, no assistente da OD ou no modo simplificado). Valor digitado
  // manda sobre tudo: syncSceneRodMin não reescreve — a tela mostra "os planos somam 52min, você
  // definiu 40min" e ela decide. Sem esta marca não dava pra separar o que a AD escolheu do que o
  // app derivou, e a decupagem apagava a escolha dela em silêncio.
  rodDigitado    Boolean             @default(false)
  // REGISTRO DE EXECUÇÃO — o que de fato aconteceu nesta diária. Vira relatório de progresso,
  // prestação de contas e justificativa de hora extra. Reordenar a diária ou salvar a OD NUNCA pode
  // reescrever estes três: a rota de reordenação atualiza a linha no lugar (nada de apagar e
  // recriar) e só mexe em ordem/bloco/prep/Rod. Mudar a cena de diária é o único caso em que
  // zeram, porque a execução pertence à diária em que aconteceu — e a tela confirma antes.
  status         SceneShootDayStatus @default(PENDENTE)
  horaInicioReal String?
  horaFimReal    String?

  // Notas operacionais do AD pra esta cena NESTA diária (diferente de Scene.notasAD, que é geral,
  // e do BreakdownSheet, que é técnico) — pré-preenchidas automaticamente na primeira vez que a
  // cena é agendada num dia (ver stripboard/reorder route), editáveis livremente depois.
  // observacoesAutoGeradas vira false assim que o AD edita o campo (controla o badge "Gerado
  // automaticamente" na UI).
  observacoes            String?  @db.Text
  observacoesAutoGeradas Boolean  @default(false)

  // Qual parte da cena dividida esta linha agenda. null = cena sem divisão. Unique: cada parte está
  // em no máximo uma diária. O unique (shootDayId, sceneId) abaixo continua valendo, então duas
  // partes da mesma cena nunca caem na mesma diária.
  scenePartId String? @unique

  scene     Scene      @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  shootDay  ShootDay   @relation(fields: [shootDayId], references: [id], onDelete: Cascade)
  scenePart ScenePart? @relation(fields: [scenePartId], references: [id], onDelete: SetNull)

  @@unique([shootDayId, sceneId])
  @@unique([shootDayId, ordem])
  @@map("scene_shoot_days")
}

model Extra {
  id         String   @id @default(cuid())
  projectId  String
  personagem String
  quantidade Int      @default(1)
  chamada    DateTime? @db.Time
  saida      DateTime? @db.Time
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  project Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  cenas   ExtraScene[]

  @@map("extras")
}

model ExtraScene {
  id      String @id @default(cuid())
  extraId String
  sceneId String

  extra Extra @relation(fields: [extraId], references: [id], onDelete: Cascade)
  scene Scene @relation(fields: [sceneId], references: [id], onDelete: Cascade)

  @@unique([extraId, sceneId])
  @@map("extra_scenes")
}

model BreakdownSheet {
  id                  String   @id @default(cuid())
  sceneId             String   @unique
  figurino            String[]
  make                String[]
  arteDressing        String?  @db.Text
  objetos             String[]
  comidaCena          String[]
  microfones          String[]
  trilha              String[]
  habilidades         String[]
  arteGrafica         String[]
  posProducao         String[]
  notasArte           String?  @db.Text
  notasFoto           String?  @db.Text
  notasSom            String?  @db.Text
  notasContinuidade   String?  @db.Text
  notasProducao       String?  @db.Text
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  scene Scene @relation(fields: [sceneId], references: [id], onDelete: Cascade)

  @@map("breakdown_sheets")
